# Copy to .env.local. Never commit real credentials.
# Local AI generation and assistant (server-only).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.302.ai/v1
OPENAI_MODEL=deepseek-v3.2
OPENAI_ASSISTANT_MODEL=deepseek-v3.2

# Leave these empty for local filesystem mode.
# Vercel: /api/cloud; static frontend: https://your-worker.workers.dev
NEXT_PUBLIC_NOTES_API_BASE=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Vercel server-only Worker origin; used with /api/cloud above.
NOTES_UPSTREAM_URL=

# Leave DEPLOY_TARGET unset for Next.js/Vercel.
# Use cloudflare-pages only when building a static export.
